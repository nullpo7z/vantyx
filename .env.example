# cp .env.example .env
# Edit /path/to/vantyx in docker-compose.yml and: mkdir -p /path/to/vantyx/{certs,data,recordings}
# docker compose pull && docker compose up -d
#
# Values below are read via docker-compose.yml (environment: …=${…}).

VANTYX_EXTERNAL_HOST=localhost

# Timezone for logs, audit trail, UI and CLI (IANA name; default UTC). One clock for everything a person reads.
VANTYX_TIMEZONE=UTC

# Required for storing SSH passwords/keys at rest. Generate with: openssl rand -base64 32
VANTYX_SSH_PASSWORD_ENCRYPTION_KEY=

# Initial admin (username: admin). Unset = random password printed once to container logs on first boot.
# Set a fixed value for local dev if you do not want the random first-boot password.
# VANTYX_INITIAL_ADMIN_PASSWORD=Admin123!

# Optional: 証明書 SAN を複数にする場合のみ（既定は VANTYX_EXTERNAL_HOST と同じ）
# VANTYX_TLS_SANS=192.168.1.10,vantyx.example.com

# Optional: OpenID Connect single sign-on (enabled when ISSUER and CLIENT_ID are both set).
# See docs/configuration.md#single-sign-on-openid-connect
# VANTYX_OIDC_ISSUER=https://keycloak.example/realms/ops
# Only when the well-known document is not under the issuer (e.g. Cloudflare Access SaaS apps):
# VANTYX_OIDC_DISCOVERY_URL=https://<team>.cloudflareaccess.com/cdn-cgi/access/sso/oidc/<client-id>
# VANTYX_OIDC_CLIENT_ID=vantyx
# VANTYX_OIDC_CLIENT_SECRET=
# VANTYX_OIDC_REDIRECT_URL=https://vantyx.example/api/auth/oidc/callback
# VANTYX_OIDC_SCOPES=openid profile email
# VANTYX_OIDC_USERNAME_CLAIM=preferred_username
# VANTYX_OIDC_AUTO_CREATE_USERS=0
# VANTYX_OIDC_DISPLAY_NAME=SSO
# Map IdP groups (from the "groups" claim) to Vantyx groups / the admin role, reconciled on every login:
# VANTYX_OIDC_GROUPS_CLAIM=groups
# VANTYX_OIDC_GROUP_MAP=netops=net,netops=net/tokyo,helpdesk=support
# VANTYX_OIDC_ADMIN_GROUPS=vantyx-admins

# Never enable in production:
# VANTYX_ALLOW_PLAINTEXT_SECRETS=1
# VANTYX_DISABLE_ORIGIN_CHECK=1

# Optional: cap ffmpeg/agg recording work at this fraction of CPU cores and RAM (default 0.8).
# VANTYX_RECORDING_RESOURCE_LIMIT=0.8

# Optional: bearer token for Prometheus scrapes of /metrics (without it, only admin sessions can read it).
# VANTYX_METRICS_TOKEN=

# Optional: age-based purge (Go durations; empty = keep forever). Runs hourly, audited as retention_purge.
# VANTYX_RECORDING_RETENTION=2160h
# VANTYX_AUDIT_RETENTION=8760h
# VANTYX_COMMAND_LOG_RETENTION=8760h
# VANTYX_MEMBERSHIP_EXPIRED_RETENTION=720h

# Optional: max time for a single GIF/MP4 export conversion (default 45m).
# VANTYX_RECORDING_EXPORT_CONVERT_TIMEOUT=45m

# Optional: how long completed/failed/cancelled export jobs are kept in memory and on disk (default 168h).
# VANTYX_RECORDING_EXPORT_COMPLETED_TTL=168h
